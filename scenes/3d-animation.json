{
  "name": "Animation Showcase",
  "type": "3d",
  "objects": [
    {
      "type": "plane",
      "name": "Floor",
      "position": {
        "x": 0,
        "y": 0,
        "z": 0
      },
      "rotation": {
        "x": -1.5707963267948966,
        "y": 0,
        "z": 0
      },
      "scale": {
        "x": 15,
        "y": 15,
        "z": 1
      },
      "color": "#333333",
      "metalness": 0.1,
      "roughness": 0.8
    },
    {
      "type": "box",
      "name": "Spinning Cube",
      "position": {
        "x": -4,
        "y": 1,
        "z": 0
      },
      "color": "#ff0000",
      "animation": {
        "code": "this.mesh.rotation.x += 0.02;\nthis.mesh.rotation.y += 0.03;\nthis.mesh.rotation.z += 0.01;"
      }
    },
    {
      "type": "sphere",
      "name": "Bouncing Ball",
      "position": {
        "x": -2,
        "y": 1,
        "z": 0
      },
      "color": "#00ff00",
      "animation": {
        "code": "this.mesh.position.y = Math.abs(Math.sin(Date.now() * 0.003)) * 4 + 0.5;"
      }
    },
    {
      "type": "torus",
      "name": "Orbiting Torus",
      "position": {
        "x": 0,
        "y": 1,
        "z": 0
      },
      "color": "#0000ff",
      "animation": {
        "code": "const t = Date.now() * 0.001;\nthis.mesh.position.x = Math.cos(t) * 2;\nthis.mesh.position.z = Math.sin(t) * 2;\nthis.mesh.rotation.x += 0.01;"
      }
    },
    {
      "type": "cylinder",
      "name": "Pulsing Cylinder",
      "position": {
        "x": 2,
        "y": 1,
        "z": 0
      },
      "color": "#ffff00",
      "animation": {
        "code": "const scale = 1 + Math.sin(Date.now() * 0.002) * 0.5;\nthis.mesh.scale.set(scale, 1, scale);"
      }
    },
    {
      "type": "cone",
      "name": "Wave Cone",
      "position": {
        "x": 4,
        "y": 1,
        "z": 0
      },
      "color": "#ff00ff",
      "animation": {
        "code": "this.mesh.position.x = 4 + Math.sin(Date.now() * 0.002) * 2;\nthis.mesh.rotation.y += 0.02;"
      }
    },
    {
      "type": "sphere",
      "name": "Color Cycle",
      "position": {
        "x": 0,
        "y": 2,
        "z": -3
      },
      "color": "#ffffff",
      "animation": {
        "code": "if (!this.colorTime) this.colorTime = 0;\nthis.colorTime += 0.01;\nconst hue = (this.colorTime % 1.0);\nthis.material.color.setHSL(hue, 1.0, 0.5);"
      }
    }
  ],
  "lights": [
    {
      "type": "ambient",
      "name": "Ambient Light",
      "color": "#404040",
      "intensity": 0.5
    },
    {
      "type": "directional",
      "name": "Sun Light",
      "color": "#ffffff",
      "intensity": 1,
      "position": {
        "x": 5,
        "y": 10,
        "z": 5
      },
      "castShadow": true
    }
  ]
}
